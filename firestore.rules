rules_version = '2';

// Seuls les comptes Google des associés lisent et écrivent les données du CRM.
service cloud.firestore {
  match /databases/{database}/documents {
    function equipe() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'sachamuller79@gmail.com',
          'loic.bistch8@gmail.com',
          'agence.sl.68@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if equipe();
    }
  }
}
