rules_version = '2';

// Seuls les comptes Google des associés lisent et écrivent les données du CRM.
// Remplacez l'adresse de Loïc par la sienne avant de publier ces règles.
service cloud.firestore {
  match /databases/{database}/documents {
    function equipe() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'sachamuller79@gmail.com',
          'agence.sl.68@gmail.com',
          'ADRESSE_DE_LOIC@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if equipe();
    }
  }
}
